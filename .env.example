# PumpDesk configuration template. Copy to .env locally and fill in values there.
# Never commit .env, real credentials, wallet key files, or other secrets.

# Telegram alerts: create/rotate the token with @BotFather.
# Keep the replacement token and chat ID only in your local .env.
TG_TOKEN=
TG_CHAT_ID=

# Helius RPC: create a new key in the Helius dashboard.
HELIUS_KEY=

# Optional explicit RPC endpoints. These override the Helius-derived endpoint.
RPC_WSS=
RPC_HTTP=

# Live trading safeguards. Keep disabled until every validation gate passes.
LIVE=false
# Live startup also requires the explicit --live CLI flag and the exact
# confirmation phrase required by the application.
LIVE_CONFIRM=
WALLET_FILE=

# Current-exposure cap. SOL_USD_PRICE must be refreshed before live startup.
# Entry size is otherwise determined by equity, risk rules, cash, and reserves.
SOL_USD_PRICE=
FUNDING_LIMIT_USD=50
