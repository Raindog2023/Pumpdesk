# PumpDesk secrets. This file stays on your PC. Never share it or upload it.
# No wallet keys go here, ever. PumpDesk never trades real money.

# Telegram alerts: token from @BotFather, chat id from @userinfobot (or your group's id)
TG_TOKEN=
TG_CHAT_ID=

# Strongly recommended: a free Helius key (https://dashboard.helius.dev) gives a stable feed.
# Without it PumpDesk uses Solana's public RPC, which drops the connection every ~40s.
HELIUS_KEY=

# Or any Solana websocket RPC URL (overrides HELIUS_KEY)
RPC_WSS=

# HTTP RPC for sending transactions (defaults to public Solana or Helius)
RPC_HTTP=

# ─── Live trading (DANGEROUS — real money) ──────────────────────────────
# Set LIVE=true and point WALLET_FILE to a Solana CLI 64-byte secret JSON.
# Default is false (paper mode).  Paper is always safe; live is never.
LIVE=false
WALLET_FILE=
